{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp exec vite dev",
		"build": "vp exec vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "vp exec svelte-kit sync || echo ''",
		"check": "vp exec svelte-kit sync && vp exec svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "vp exec svelte-kit sync && vp exec svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --check \"**/*.svelte\"",
		"format": "oxfmt \"**/*.svelte\"",
		"test:unit": "vp exec vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "vp exec playwright install && vp exec playwright test",
		"gen": "rm -rf .svelte-kit/cloudflare && wrangler types"
	},
	"devDependencies": {
		"@fontsource-variable/victor-mono": "catalog:",
		"@internationalized/date": "catalog:",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-cloudflare": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"bits-ui": "catalog:",
		"clsx": "catalog:",
		"oxfmt": "catalog:",
		"phosphor-svelte": "catalog:",
		"playwright": "catalog:",
		"shadcn-svelte": "catalog:",
		"svead": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:typescript6",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:",
		"wrangler": "catalog:"
	},
	"packageManager": "pnpm@12.3.3"
}
