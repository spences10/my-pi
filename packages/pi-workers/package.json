{
	"name": "@spences10/pi-workers",
	"version": "0.2.0",
	"description": "Local RPC workers that participate in Team Mode and observability",
	"keywords": [
		"pi",
		"pi-package",
		"workers"
	],
	"homepage": "https://github.com/spences10/my-pi/tree/main/packages/pi-workers#readme",
	"license": "MIT",
	"author": "Scott Spence <me@scottspence.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spences10/my-pi.git",
		"directory": "packages/pi-workers"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm --filter \"$npm_package_name^...\" run build:self && pnpm run build:self",
		"build:self": "vp exec tsc -p tsconfig.build.json",
		"check": "pnpm --filter \"$npm_package_name^...\" run build:self && pnpm run check:self",
		"check:self": "vp exec tsc --noEmit -p tsconfig.json",
		"test": "pnpm --filter \"$npm_package_name^...\" run build:self && pnpm run test:self",
		"test:self": "vp test run"
	},
	"dependencies": {
		"@spences10/pi-redact": "workspace:*",
		"@spences10/pi-team-mode": "workspace:*",
		"@spences10/pi-tui-modal": "workspace:*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@earendil-works/pi-tui": "catalog:",
		"@spences10/pi-observability": "workspace:*",
		"@types/node": "catalog:",
		"typebox": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		],
		"image": "https://raw.githubusercontent.com/spences10/my-pi/main/assets/pi-package-preview.png"
	}
}
