{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"minimumReleaseAge": "2 days",
	"packageRules": [
		{
			"description": "Keep Pi packages aligned across workspace packages",
			"matchManagers": ["npm"],
			"matchPackageNames": [
				"/^@earendil-works\\//",
				"/^@mariozechner\\//"
			],
			"groupName": "Pi packages",
			"groupSlug": "pi-packages"
		},
		{
			"description": "Keep Svelte packages aligned across the workspace",
			"matchManagers": ["npm"],
			"matchPackageNames": [
				"/^@sveltejs\\//",
				"svelte",
				"svelte-check"
			],
			"groupName": "Svelte packages",
			"groupSlug": "svelte-packages"
		},
		{
			"description": "Keep Playwright and browser test integration aligned across the workspace",
			"matchManagers": ["npm"],
			"matchPackageNames": [
				"/^@playwright\\//",
				"playwright",
				"vitest-browser-svelte"
			],
			"groupName": "Browser test tooling",
			"groupSlug": "browser-test-tooling"
		},
		{
			"description": "Update Vite+ and its aliased Vite core together",
			"matchManagers": ["npm"],
			"matchPackageNames": [
				"vite-plus",
				"@voidzero-dev/vite-plus-core"
			],
			"groupName": "Vite+ toolchain",
			"groupSlug": "vite-plus-toolchain",
			"rangeStrategy": "pin"
		},
		{
			"description": "Manage Vitest and its plugins through Vite+'s bundled versions",
			"matchManagers": ["npm"],
			"matchPackageNames": ["vitest", "/^@vitest\\//"],
			"enabled": false
		},
		{
			"description": "Group GitHub Actions updates",
			"matchManagers": ["github-actions"],
			"groupName": "GitHub Actions",
			"groupSlug": "github-actions"
		},
		{
			"description": "Do not open PRs for temporary/security pins in pnpm-workspace overrides",
			"matchManagers": ["npm"],
			"matchFileNames": ["pnpm-workspace.yaml"],
			"matchDepTypes": ["pnpm-workspace.overrides"],
			"enabled": false
		}
	]
}
